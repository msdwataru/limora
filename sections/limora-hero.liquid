<div class="limora-hero">
  <div class="limora-hero__inner page-width">
    <img
      class="limora-hero__logo{% if settings.animations_reveal_on_scroll %} scroll-trigger limora-hero__reveal limora-hero__reveal--logo{% endif %}"
      src="{{ 'limora-logo.png' | asset_url }}"
      alt="{{ section.settings.heading | default: 'LIMORA' }}"
      width="420"
      height="210"
      loading="lazy"
    >
    {%- if section.settings.heading != blank -%}
      <h1 class="limora-hero__heading{% if settings.animations_reveal_on_scroll %} scroll-trigger limora-hero__reveal limora-hero__reveal--delay-1{% endif %}">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="limora-hero__text{% if settings.animations_reveal_on_scroll %} scroll-trigger limora-hero__reveal limora-hero__reveal--delay-2{% endif %}">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button limora-hero__button{% if settings.animations_reveal_on_scroll %} scroll-trigger limora-hero__reveal limora-hero__reveal--delay-3{% endif %}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% style %}
  .limora-hero {
    background-color: #FAF6F0;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .limora-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.6rem;
  }

  .limora-hero__logo {
    width: min(100%, 36rem);
    height: auto;
  }

  .limora-hero__heading {
    margin: 0;
    color: #4A3F35;
  }

  .limora-hero__text {
    max-width: 48rem;
    color: #6B5B4D;
    font-size: 1.6rem;
    line-height: 1.8;
  }

  .limora-hero__button {
    margin-top: 0.8rem;
  }

  .limora-hero__reveal {
    opacity: 0;
    transform: translateY(2.8rem);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .limora-hero__reveal.scroll-trigger:not(.scroll-trigger--offscreen) {
    opacity: 1;
    transform: translateY(0);
  }

  .limora-hero__reveal--logo {
    transform: scale(0.8);
    filter: blur(14px);
    transition:
      opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.4s ease-out;
  }

  .limora-hero__reveal--logo.scroll-trigger:not(.scroll-trigger--offscreen) {
    transform: scale(1);
    filter: blur(0);
  }

  .limora-hero__reveal--delay-1 {
    transition-delay: 0.15s;
  }

  .limora-hero__reveal--delay-2 {
    transition-delay: 0.3s;
  }

  .limora-hero__reveal--delay-3 {
    transition-delay: 0.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .limora-hero__reveal,
    .limora-hero__reveal--logo {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "LIMORA ヒーロー",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "LIMORA"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "本文",
      "default": "<p>毎日の服選びを少しだけ軽くする。韓国カジュアル × ナチュラルテイストのデイリーウェア。</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタンラベル",
      "default": "コレクションを見る"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク先"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上の余白",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下の余白",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LIMORA ヒーロー"
    }
  ]
}
{% endschema %}

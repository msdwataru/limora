<div class="limora-hero">
  <div class="limora-hero__inner page-width">
    <img
      class="limora-hero__logo"
      src="{{ 'limora-logo.png' | asset_url }}"
      alt="{{ section.settings.heading | default: 'LIMORA' }}"
      width="420"
      height="210"
      loading="lazy"
    >
    {%- if section.settings.heading != blank -%}
      <h1 class="limora-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="limora-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button limora-hero__button">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% style %}
  .limora-hero {
    background-color: #FAF6F0;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .limora-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.6rem;
  }

  .limora-hero__logo {
    width: min(100%, 36rem);
    height: auto;
  }

  .limora-hero__heading {
    margin: 0;
    color: #4A3F35;
  }

  .limora-hero__text {
    max-width: 48rem;
    color: #6B5B4D;
    font-size: 1.6rem;
    line-height: 1.8;
  }

  .limora-hero__button {
    margin-top: 0.8rem;
  }
{% endstyle %}

{% schema %}
{
  "name": "LIMORA ヒーロー",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "LIMORA"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "本文",
      "default": "<p>毎日の服選びを少しだけ軽くする。韓国カジュアル × ナチュラルテイストのデイリーウェア。</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタンラベル",
      "default": "コレクションを見る"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク先"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上の余白",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下の余白",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LIMORA ヒーロー"
    }
  ]
}
{% endschema %}

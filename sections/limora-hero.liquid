<div class="limora-hero">
  {%- if settings.animations_reveal_on_scroll -%}
    <div class="limora-hero__curtain" aria-hidden="true"></div>
  {%- endif -%}
  <div class="limora-hero__inner page-width">
    <img
      class="limora-hero__logo{% if settings.animations_reveal_on_scroll %} limora-hero__intro limora-hero__intro--logo{% endif %}"
      src="{{ 'limora-logo.png' | asset_url }}"
      alt="{{ section.settings.heading | default: 'LIMORA' }}"
      width="420"
      height="210"
      loading="lazy"
    >
    {%- if section.settings.heading != blank -%}
      <h1 class="limora-hero__heading{% if settings.animations_reveal_on_scroll %} limora-hero__intro limora-hero__intro--delay-1{% endif %}">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="limora-hero__text{% if settings.animations_reveal_on_scroll %} limora-hero__intro limora-hero__intro--delay-2{% endif %}">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button limora-hero__button{% if settings.animations_reveal_on_scroll %} limora-hero__intro limora-hero__intro--delay-3{% endif %}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% style %}
  .limora-hero {
    position: relative;
    overflow: hidden;
    background-color: #FAF6F0;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .limora-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.6rem;
  }

  .limora-hero__logo {
    width: min(100%, 36rem);
    height: auto;
  }

  .limora-hero__heading {
    margin: 0;
    color: #4A3F35;
  }

  .limora-hero__text {
    max-width: 48rem;
    color: #6B5B4D;
    font-size: 1.6rem;
    line-height: 1.8;
  }

  .limora-hero__button {
    margin-top: 0.8rem;
  }

  .limora-hero__curtain {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(155deg, #4A3F35 0%, #C08552 55%, #A3B18A 100%);
    transform-origin: top;
    animation: limora-hero-curtain 1.5s cubic-bezier(0.76, 0, 0.24, 1) 0.3s forwards;
  }

  @keyframes limora-hero-curtain {
    0% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(0);
    }
  }

  .limora-hero__intro {
    opacity: 0;
    transform: translateY(3.2rem);
    animation: limora-hero-intro 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.95s forwards;
  }

  @keyframes limora-hero-intro {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .limora-hero__intro--logo {
    transform: translateY(1.6rem) scale(0.86);
    filter: blur(10px);
    animation-name: limora-hero-intro-logo;
    animation-delay: 0.75s;
  }

  @keyframes limora-hero-intro-logo {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .limora-hero__intro--delay-1 {
    animation-delay: 1.1s;
  }

  .limora-hero__intro--delay-2 {
    animation-delay: 1.25s;
  }

  .limora-hero__intro--delay-3 {
    animation-delay: 1.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .limora-hero__curtain {
      display: none;
    }

    .limora-hero__intro,
    .limora-hero__intro--logo {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "LIMORA ヒーロー",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "LIMORA"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "本文",
      "default": "<p>毎日の服選びを少しだけ軽くする。韓国カジュアル × ナチュラルテイストのデイリーウェア。</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタンラベル",
      "default": "コレクションを見る"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタンリンク先"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上の余白",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下の余白",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "LIMORA ヒーロー"
    }
  ]
}
{% endschema %}
